---
layout: null
permalink: /search.json
sitemap: false
---
{%- assign writeups = site.writeups | sort: "date" | reverse -%}
[
{%- for w in writeups %}
  {
    "title": {{ w.title | jsonify }},
    "url": {{ w.url | relative_url | jsonify }},
    "date": {{ w.date | date: "%b %-d, %Y" | jsonify }},
    "category": {{ w.category | jsonify }},
    "platform": {{ w.platform | jsonify }},
    "difficulty": {{ w.difficulty | jsonify }},
    "tags": {{ w.tags | jsonify }},
    "summary": {{ w.summary | jsonify }},
    "content": {{ w.content | strip_html | normalize_whitespace | truncate: 6000 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
